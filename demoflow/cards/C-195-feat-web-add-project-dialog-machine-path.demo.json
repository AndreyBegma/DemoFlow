{
  "schemaVersion": 1,
  "name": "Add project dialog",
  "description": "Sign in off camera, then open the new Add project dialog from the Projects page: it replaces the old create and bind forms with one place to choose a machine and a folder, and closes with Escape.",
  "viewport": { "width": 1280, "height": 720 },
  "setup": [
    {
      "action": "include",
      "fragment": "sign-in",
      "with": { "next": "/app/projects" }
    }
  ],
  "steps": [
    {
      "action": "assertVisible",
      "target": { "role": "heading", "name": "Projects", "exact": true }
    },
    {
      "action": "click",
      "target": { "role": "button", "name": "Add project", "exact": true }
    },
    {
      "action": "assertVisible",
      "target": { "role": "dialog", "name": "Add project", "exact": true }
    },
    { "action": "press", "key": "Escape" },
    {
      "action": "assertVisible",
      "target": { "role": "heading", "name": "Projects", "exact": true }
    }
  ]
}
