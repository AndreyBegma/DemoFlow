{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // No Node types: `src` must not reach for Node APIs (ADR-0001).
    "types": [],
    "noEmit": false,
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
