{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "captions": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": ["startMs", "endMs", "text"],
        "additionalProperties": false
      }
    },
    "zoom": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stepIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "zoom": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "number",
                "minimum": 1,
                "maximum": 3
              }
            ]
          }
        },
        "required": ["stepIndex", "zoom"],
        "additionalProperties": false
      }
    },
    "trim": {
      "type": "object",
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "cuts": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["startMs", "endMs"],
        "additionalProperties": false
      }
    },
    "cards": {
      "type": "object",
      "properties": {
        "intro": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            },
            "subtitle": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "scenes": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "outro": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                "cta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                }
              },
              "required": ["title"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "background": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "enum": ["ocean", "sunset", "forest", "dusk", "graphite", "paper"]
            }
          },
          "required": ["preset"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": ["color"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "gradient": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "angle": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360,
                  "description": "Degrees, as in CSS linear-gradient: 0 runs towards the top, clockwise (90 towards the right)."
                }
              },
              "required": ["from", "to", "angle"],
              "additionalProperties": false
            }
          },
          "required": ["gradient"],
          "additionalProperties": false
        }
      ]
    },
    "frame": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "shadow": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion"],
  "additionalProperties": false
}
