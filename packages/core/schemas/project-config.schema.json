{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DemoFlow project config",
  "description": "demoflow.config.json at the project root.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "baseUrl": {
      "type": "string",
      "pattern": "^[hH][tT][tT][pP][sS]?://",
      "description": "Where the app runs. ${PORT} is the port of the run: --port, else PORT from the environment, else the default in ${PORT:-3000}. $${ is a literal ${."
    },
    "allowedOrigins": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^[hH][tT][tT][pP][sS]?://"
      }
    },
    "devCommand": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "The program that starts the app, run without a shell. ${PORT} is the port of the run: --port, else PORT from the environment, else the default in ${PORT:-3000}. $${ is a literal ${. ${BASE_URL} is --base-url, else baseUrl after substitution."
        },
        "args": {
          "description": "Its arguments, one string each. ${PORT} is the port of the run: --port, else PORT from the environment, else the default in ${PORT:-3000}. $${ is a literal ${. ${BASE_URL} is --base-url, else baseUrl after substitution.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readyUrl": {
          "type": "string",
          "pattern": "^[hH][tT][tT][pP][sS]?://",
          "description": "The app is up once this URL answers. ${PORT} is the port of the run: --port, else PORT from the environment, else the default in ${PORT:-3000}. $${ is a literal ${. ${BASE_URL} is --base-url, else baseUrl after substitution."
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["command", "readyUrl"],
      "additionalProperties": false
    },
    "artifactsDir": {
      "type": "string",
      "minLength": 1
    },
    "fragmentsDir": {
      "description": "Where the fragments scenarios include live, relative to the project root. Default demoflow/fragments.",
      "type": "string",
      "minLength": 1
    },
    "render": {
      "default": {},
      "type": "object",
      "properties": {
        "width": {
          "default": 1920,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "default": 1080,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "default": 30,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "idle": {
          "default": {},
          "type": "object",
          "properties": {
            "thresholdMs": {
              "default": 1000,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "compressToMs": {
              "default": 400,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "endHoldMs": {
          "default": 2500,
          "description": "How long a successful video keeps the result on screen after the last step: the engine keeps recording and the renderer keeps the frames. 0 ends the video at the last step.",
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "frame": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "marginRatio": {
              "default": 0.06,
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 0.25
            },
            "radius": {
              "default": 12,
              "type": "number",
              "minimum": 0
            },
            "shadow": {
              "default": true,
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "background": {
          "default": {
            "preset": "ocean"
          },
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "preset": {
                  "type": "string",
                  "enum": [
                    "ocean",
                    "sunset",
                    "forest",
                    "dusk",
                    "graphite",
                    "paper"
                  ]
                }
              },
              "required": ["preset"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "required": ["color"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "gradient": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "angle": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 360,
                      "description": "Degrees, as in CSS linear-gradient: 0 runs towards the top, clockwise (90 towards the right)."
                    }
                  },
                  "required": ["from", "to", "angle"],
                  "additionalProperties": false
                }
              },
              "required": ["gradient"],
              "additionalProperties": false
            }
          ]
        },
        "cards": {
          "default": {},
          "type": "object",
          "properties": {
            "intro": {
              "default": {},
              "type": "object",
              "properties": {
                "enabled": {
                  "default": true,
                  "type": "boolean"
                },
                "durationMs": {
                  "default": 2000,
                  "type": "integer",
                  "minimum": 500,
                  "maximum": 10000
                }
              },
              "additionalProperties": false
            },
            "scenes": {
              "default": {},
              "type": "object",
              "properties": {
                "enabled": {
                  "default": true,
                  "type": "boolean"
                },
                "durationMs": {
                  "default": 1500,
                  "type": "integer",
                  "minimum": 500,
                  "maximum": 10000
                }
              },
              "additionalProperties": false
            },
            "outro": {
              "default": {},
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                "cta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                "durationMs": {
                  "default": 2500,
                  "type": "integer",
                  "minimum": 500,
                  "maximum": 10000
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "transitions": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "durationMs": {
              "description": "Milliseconds; at most half the shortest card that is on. Default 300, or half the shortest card when that is less.",
              "type": "integer",
              "minimum": 100,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        },
        "formats": {
          "default": ["mp4"],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mp4",
              "gif",
              "webm",
              "mp4-vertical",
              "gif-vertical",
              "webm-vertical",
              "mp4-square",
              "gif-square",
              "webm-square"
            ]
          }
        },
        "gif": {
          "default": {},
          "type": "object",
          "properties": {
            "width": {
              "description": "Pixels, at most render.width. Default 800, or render.width when that is less.",
              "type": "integer",
              "minimum": 160,
              "maximum": 9007199254740991
            },
            "fps": {
              "description": "At most render.fps. Default 12, or render.fps when that is less.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "vertical": {
          "default": {},
          "type": "object",
          "properties": {
            "followMs": {
              "default": 400,
              "description": "Milliseconds the crop takes to move to the next target, eased in and out.",
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "deadZone": {
              "default": 0.1,
              "description": "A move shorter than this share of the crop width is skipped, so the camera does not jitter.",
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 0.5
            },
            "captionBand": {
              "default": 0.22,
              "description": "The share of the frame height, at the bottom, that captions sit in.",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.5
            }
          },
          "additionalProperties": false
        },
        "square": {
          "default": {},
          "type": "object",
          "properties": {
            "followMs": {
              "default": 400,
              "description": "Milliseconds the crop takes to move to the next target, eased in and out.",
              "type": "integer",
              "minimum": 0,
              "maximum": 2000
            },
            "deadZone": {
              "default": 0.1,
              "description": "A move shorter than this share of the crop width is skipped, so the camera does not jitter.",
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 0.5
            },
            "captionBand": {
              "default": 0.22,
              "description": "The share of the frame height, at the bottom, that captions sit in.",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.5
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "share": {
      "type": "object",
      "properties": {
        "allowMcp": {
          "default": false,
          "description": "Let the MCP server (share_demo) publish the video of a run as a public link without asking anyone. Off by default; anyone with the link can watch until it expires or is revoked.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["baseUrl"],
  "additionalProperties": false
}
