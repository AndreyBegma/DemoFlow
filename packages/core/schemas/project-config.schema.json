{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DemoFlow project config",
  "description": "demoflow.config.json at the project root.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^[hH][tT][tT][pP][sS]?://"
    },
    "allowedOrigins": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^[hH][tT][tT][pP][sS]?://"
      }
    },
    "devCommand": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readyUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^[hH][tT][tT][pP][sS]?://"
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["command", "readyUrl"],
      "additionalProperties": false
    },
    "artifactsDir": {
      "type": "string",
      "minLength": 1
    },
    "render": {
      "default": {},
      "type": "object",
      "properties": {
        "width": {
          "default": 1920,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "default": 1080,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "default": 30,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "idle": {
          "default": {},
          "type": "object",
          "properties": {
            "thresholdMs": {
              "default": 1000,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "compressToMs": {
              "default": 400,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "frame": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "marginRatio": {
              "default": 0.06,
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 0.25
            },
            "radius": {
              "default": 12,
              "type": "number",
              "minimum": 0
            },
            "shadow": {
              "default": true,
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "background": {
          "default": {
            "preset": "ocean"
          },
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "preset": {
                  "type": "string",
                  "enum": [
                    "ocean",
                    "sunset",
                    "forest",
                    "dusk",
                    "graphite",
                    "paper"
                  ]
                }
              },
              "required": ["preset"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "required": ["color"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "gradient": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "angle": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 360,
                      "description": "Degrees, as in CSS linear-gradient: 0 runs towards the top, clockwise (90 towards the right)."
                    }
                  },
                  "required": ["from", "to", "angle"],
                  "additionalProperties": false
                }
              },
              "required": ["gradient"],
              "additionalProperties": false
            }
          ]
        },
        "cards": {
          "default": {},
          "type": "object",
          "properties": {
            "intro": {
              "default": {},
              "type": "object",
              "properties": {
                "enabled": {
                  "default": true,
                  "type": "boolean"
                },
                "durationMs": {
                  "default": 2000,
                  "type": "integer",
                  "minimum": 500,
                  "maximum": 10000
                }
              },
              "additionalProperties": false
            },
            "scenes": {
              "default": {},
              "type": "object",
              "properties": {
                "enabled": {
                  "default": true,
                  "type": "boolean"
                },
                "durationMs": {
                  "default": 1500,
                  "type": "integer",
                  "minimum": 500,
                  "maximum": 10000
                }
              },
              "additionalProperties": false
            },
            "outro": {
              "default": {},
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                "cta": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "\\S"
                },
                "durationMs": {
                  "default": 2500,
                  "type": "integer",
                  "minimum": 500,
                  "maximum": 10000
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["baseUrl"],
  "additionalProperties": false
}
