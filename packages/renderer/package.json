{
  "name": "@demoflow/renderer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "test:update-baselines": "node test/visual/update-baselines.ts",
    "lint": "biome lint src test"
  },
  "dependencies": {
    "@demoflow/core": "workspace:*",
    "ffmpeg-static": "5.3.0",
    "opentype.js": "2.0.0"
  },
  "devDependencies": {
    "@demoflow/engine": "workspace:*",
    "@demoflow/fixture": "workspace:*",
    "@types/node": "24.19.0",
    "typescript": "6.0.2",
    "vitest": "5.0.3"
  }
}
