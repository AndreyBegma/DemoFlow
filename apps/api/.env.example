PORT=8370
APP_ENV=development
API_URL=http://localhost:8370
WEB_URL=http://localhost:3670

DATABASE_URL="postgresql://postgres:change-me@localhost:5470/demoflow?schema=public"
# Integration specs (`bun run test`) need their own database; it is created
# and migrated on the first run. Without it they fail and say so.
TEST_DATABASE_URL="postgresql://postgres:change-me@localhost:5470/demoflow_test?schema=public"

# Account emails. With no key, below production, they go to the API log.
# APP_ENV=production refuses to start without a key unless MAIL_TRANSPORT=log.
RESEND_API_KEY=
MAIL_FROM=DemoFlow <no-reply@localhost>
# resend | log — overrides the choice above.
# MAIL_TRANSPORT=log

# GitHub sign-in: a GitHub OAuth App's credentials. While either is empty the
# button is hidden and /auth/github/start is a 404. The app's callback URL is
# ${WEB_URL}/api/auth/github/callback — locally
# http://localhost:3670/api/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Share links (spec #347): the directory that holds every shared video and
# poster, relative to the API's working directory unless absolute. Nothing
# else is written there; it is not backed up.
SHARE_DIR=./data/shares
# The largest render a share may hold (200 MB), and every account's total
# across its shares, posters included (2 GB).
SHARE_MAX_FILE_BYTES=209715200
SHARE_USER_QUOTA_BYTES=2147483648
