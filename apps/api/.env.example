PORT=8370
APP_ENV=development
API_URL=http://localhost:8370
WEB_URL=http://localhost:3670

DATABASE_URL="postgresql://postgres:change-me@localhost:5470/demoflow?schema=public"
# Integration specs (`bun run test`) need their own database; it is created
# and migrated on the first run. Without it they fail and say so.
TEST_DATABASE_URL="postgresql://postgres:change-me@localhost:5470/demoflow_test?schema=public"

# Account emails. With no key, below production, they go to the API log.
# APP_ENV=production refuses to start without a key unless MAIL_TRANSPORT=log.
RESEND_API_KEY=
MAIL_FROM=DemoFlow <no-reply@localhost>
# resend | log — overrides the choice above.
# MAIL_TRANSPORT=log
