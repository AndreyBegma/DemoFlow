{
  "name": "@demoflow/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a scenario into a demo video: a browser runs it, FFmpeg renders it. CLI and MCP server.",
  "keywords": [
    "demo",
    "video",
    "screen-recording",
    "playwright",
    "mcp",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "demoflow": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/stage.ts",
    "test": "tsc -p tsconfig.json && vitest run",
    "lint": "biome lint src test scripts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@demoflow/core": "workspace:*",
    "@demoflow/engine": "workspace:*",
    "@demoflow/renderer": "workspace:*",
    "@modelcontextprotocol/sdk": "1.31.0",
    "commander": "14.0.3",
    "playwright": "1.64.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.2",
    "vitest": "5.0.3"
  }
}
