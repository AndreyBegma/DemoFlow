{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "vite.config.ts"]
}
