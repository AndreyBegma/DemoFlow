{
  "schemaVersion": 1,
  "name": "Sign in",
  "description": "Sign in with a password read from the FIXTURE_PASSWORD environment variable.",
  "viewport": { "width": 1280, "height": 720 },
  "steps": [
    { "action": "navigate", "path": "/login" },
    {
      "action": "fill",
      "target": { "label": "Email" },
      "value": "ada@example.com"
    },
    {
      "action": "fill",
      "target": { "label": "Password" },
      "valueFrom": { "env": "FIXTURE_PASSWORD" }
    },
    { "action": "click", "target": { "role": "button", "name": "Sign in" } },
    {
      "action": "assertText",
      "target": { "role": "heading", "name": "Welcome" },
      "text": "Welcome, ada@example.com"
    }
  ]
}
