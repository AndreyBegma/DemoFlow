{
  "schemaVersion": 1,
  "name": "Create five customers",
  "description": "Creates one customer per item of data.customers through the dialog, then checks each row.",
  "viewport": { "width": 1280, "height": 720 },
  "data": {
    "customers": [
      { "name": "Grace Hopper", "email": "grace@example.com" },
      { "name": "Alan Turing", "email": "alan@example.com" },
      { "name": "Edsger Dijkstra", "email": "edsger@example.com" },
      { "name": "Barbara Liskov", "email": "barbara@example.com" },
      { "name": "Ken Thompson", "email": "ken@example.com" }
    ]
  },
  "pacing": { "stepDwellMs": 250, "typingDelayMs": 20 },
  "steps": [
    { "action": "navigate", "path": "/customers" },
    {
      "action": "repeat",
      "each": "customers",
      "as": "customer",
      "caption": "Five new customers",
      "steps": [
        {
          "action": "click",
          "target": { "role": "button", "name": "New customer" }
        },
        {
          "action": "fill",
          "target": { "label": "Name" },
          "value": "{{customer.name}}"
        },
        {
          "action": "fill",
          "target": { "label": "Email" },
          "value": "{{customer.email}}"
        },
        {
          "action": "click",
          "target": { "role": "button", "name": "Create", "exact": true }
        },
        {
          "action": "assertVisible",
          "target": { "role": "cell", "name": "{{customer.email}}" }
        }
      ]
    }
  ]
}
