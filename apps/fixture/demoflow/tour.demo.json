{
  "schemaVersion": 1,
  "name": "Tour",
  "description": "Hover, scroll the page, scroll a container, wait for a slow report, with markers and a screenshot.",
  "viewport": { "width": 1280, "height": 720 },
  "steps": [
    { "action": "navigate", "path": "/hover" },
    { "action": "marker", "title": "Hover", "kind": "scene" },
    {
      "action": "hover",
      "target": { "testId": "hover-card" },
      "caption": "Hover for details"
    },
    { "action": "screenshot", "name": "hover-tooltip" },
    { "action": "navigate", "path": "/long" },
    { "action": "marker", "title": "Scrolling", "kind": "scene" },
    { "action": "scroll", "to": "bottom" },
    { "action": "scroll", "to": "top" },
    {
      "action": "scroll",
      "to": "bottom",
      "within": { "testId": "log-panel" },
      "caption": "Scroll the log"
    },
    { "action": "navigate", "path": "/slow" },
    { "action": "marker", "title": "Slow report", "kind": "caption" },
    {
      "action": "click",
      "target": { "role": "button", "name": "Load report" }
    },
    {
      "action": "waitFor",
      "target": { "text": "Report ready" },
      "timeoutMs": 10000
    },
    { "action": "screenshot", "name": "report-ready" }
  ]
}
