# API environment on staging — see apps/api/.env.example for every variable.
# refresh.sh copies this to env/api.env on the first run. DATABASE_URL comes
# from docker-compose.yml, built from the password in .env.
PORT=8370
APP_ENV=production
# The public API origin: Caddy strips /api before the API sees it.
API_URL=https://demoflow-app.luna-realm.com/api
# CORS.
WEB_URL=https://demoflow-app.luna-realm.com
