# API environment on staging — see apps/api/.env.example for every variable.
# refresh.sh copies this to env/api.env on the first run. DATABASE_URL comes
# from docker-compose.yml, built from the password in .env.
PORT=8370
APP_ENV=production
# The public API origin: Caddy strips /api before the API sees it.
API_URL=https://demoflow-app.luna-realm.com/api
# CORS, the CSRF Origin check, and the links in account emails.
WEB_URL=https://demoflow-app.luna-realm.com
# Account emails. The owner sets the key and the verified sender, then empties
# MAIL_TRANSPORT (empty, not deleted: refresh.sh re-appends a deleted key).
# Until then each email is written to the API log (deploy/README.md,
# "Mail on staging").
RESEND_API_KEY=
MAIL_FROM=DemoFlow <no-reply@localhost>
MAIL_TRANSPORT=log
