# API environment on production — see apps/api/.env.example for every variable.
# refresh.sh copies this to env/api.env on the first run. DATABASE_URL comes
# from docker-compose.yml, built from the password in .env.
PORT=8370
APP_ENV=production
# The public API origin: Caddy strips /api before the API sees it.
API_URL=https://demoflow.luna-realm.com/api
# CORS, the CSRF Origin check, and the links in account emails.
WEB_URL=https://demoflow.luna-realm.com
# Account emails. The owner sets the key, then empties MAIL_TRANSPORT (empty,
# not deleted: refresh.sh re-appends a deleted key). Until then each email is
# written to the API log (deploy/README.md, "Mail on production").
RESEND_API_KEY=
MAIL_FROM=DemoFlow <no-reply@luna-realm.com>
MAIL_TRANSPORT=log
# GitHub sign-in (deploy/README.md, "GitHub sign-in on production"). Hidden
# while either is empty. OAuth App callback:
# https://demoflow.luna-realm.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
